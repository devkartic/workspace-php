APP_NAME=${PROJECT_NAME}
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://${HOSTNAME}

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Internal addresses point to this project's own database and Redis.
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=${DATABASE}
DB_USERNAME=${DATABASE_USER}
# Development only. Generate independent production secrets before deployment.
DB_PASSWORD=development_${PROJECT_NAME}_password

SESSION_DRIVER=file
SESSION_LIFETIME=120
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
# Laravel 10 and earlier use CACHE_DRIVER.
CACHE_DRIVER=file

# Requires predis/predis unless your project image installs the Redis extension.
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=development_${PROJECT_NAME}_redis
REDIS_PORT=6379
REDIS_PREFIX=${PROJECT_NAME}:

# Logs messages locally; configure SMTP separately for production delivery.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
