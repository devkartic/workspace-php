#!/bin/sh
# Run once as root before FPM starts; never truncate an existing log.
set -eu
directory=/var/log/project
file="$directory/php-error.log"
[ -d "$directory" ] && [ ! -L "$directory" ]
[ ! -L "$file" ]
if [ -e "$file" ]; then [ -f "$file" ]; fi
touch "$file"
chown www-data:www-data "$directory" "$file"
chmod 755 "$directory"
chmod 644 "$file"
