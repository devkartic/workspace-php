# Copy this file to docker/.env to override local ports and MariaDB credentials.
COMPOSE_PROJECT_NAME=php-workspace
NGINX_HTTP_PORT=80
MARIADB_PORT=3306
REDIS_PORT=6380
PHPMYADMIN_PORT=8081

# Project databases are generated from projects/*/project.env; this is the shared root account.
MARIADB_ROOT_PASSWORD=root
