# Namespace for independent stacks. Legacy shared volumes are never reused automatically.
COMPOSE_PROJECT_NAME=php-workspace
PRODUCTION_PROJECTS=
ACME_EMAIL=
NGINX_HTTP_PORT=80
EDGE_CPUS=0.5
EDGE_MEMORY=256m
# Database root credentials/resources are project-owned in .docker/infra.production.env.
# Application database and Redis credentials remain in that project's private .env.
