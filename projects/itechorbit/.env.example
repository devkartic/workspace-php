APP_NAME=itechorbit
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://itechorbit.local

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Application connections inside the Docker network.
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=itechorbit
DB_USERNAME=itechorbit_user
# Development only; replace with a unique production secret.
DB_PASSWORD=development_itechorbit_password

SESSION_DRIVER=file
SESSION_LIFETIME=120

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
# Laravel 10 and earlier use CACHE_DRIVER instead of CACHE_STORE.
CACHE_DRIVER=file

# Requires predis/predis when using Redis; the PHP Redis extension is not installed.
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=development_itechorbit_redis
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Docker workspace configuration
# These WORKSPACE_* settings configure Docker and Nginx, not Laravel itself.
# After changing them, run from the workspace root: make project-up NAME=itechorbit
# Database creation uses DB_DATABASE from the application section above.
# -----------------------------------------------------------------------------

# Docker service name. Use lowercase letters, numbers, and underscores.
# Keep this stable: renaming it changes the service used by workspace commands.
WORKSPACE_PROJECT_NAME=itechorbit

# PHP version for this project's container. Supported: 7.4, 8.1, 8.3, 8.4, 8.5.
WORKSPACE_PHP_VERSION=8.5

# Local domain routed to this project. Add "127.0.0.1 itechorbit.local" to /etc/hosts.
# Keep APP_URL above in sync when using this domain as the application URL.
WORKSPACE_HOSTNAME=itechorbit.local

# Optional space-separated aliases; the gateway redirects them to the canonical host.
WORKSPACE_DOMAIN_ALIASES=

# Web directory relative to this project: use public for Laravel, . for plain PHP.
WORKSPACE_DOCUMENT_ROOT=.

# Open http://localhost:8082 without editing /etc/hosts.
# Choose an unused port from 1024 to 65535; leave empty to disable this URL.
WORKSPACE_HTTP_PORT=8082
