#!/bin/sh
# Called as root with validated relative volume paths and a read-only seed mount.
set -eu
for path in "$@"; do
    target="/var/www/html/$path"
    seed="/workspace-source/$path"
    test -d "$target"
    test ! -L "$target"
    if [ -z "$(ls -A "$target")" ] && [ -d "$seed" ]; then
        cp -a "$seed/." "$target/"
    fi
    if [ "$path" = storage ]; then
        mkdir -p "$target/logs" "$target/framework/cache/data" \
            "$target/framework/sessions" "$target/framework/views" "$target/app/public"
    fi
    # Never follow application symlinks outside these volume directories.
    chown -hR www-data:www-data "$target"
    find "$target" -type d -exec chmod u+rwx {} +
    find "$target" -type f -exec chmod u+rw {} +
done
