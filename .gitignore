# Local Docker settings (copy docker/.env.example to create this file)
docker/.env
docker/generated/
docker/nginx/generated/
projects/*/logs/*
!projects/*/logs/.gitkeep

# Local database/cache state and macOS metadata
docker/data/
docker/backups/
.DS_Store
__pycache__/
.idea/
# iTechOrbit is maintained in its own Git repository.
/projects/itechorbit/
# Each application's environment may contain credentials; commit its example only.
projects/**/.env
# Reinstall application dependencies from their committed lockfiles.
projects/**/vendor/
projects/**/node_modules/

# Private production configuration and generated credentials
docker/.env.production
docker/production/
docker/.workspace-lock/

# Independent stack runtime and private project infrastructure
docker/stacks/
projects/**/.docker/infra.*.env
docker/projects/*/infra.*.env
docker/projects/.*-migration-*/
docker/.stack-*.lock/
