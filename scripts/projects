#!/bin/sh
set -eu

# Keep definitions human-editable and derive all runtime wiring from them.
# This avoids duplicating project data across Compose and Nginx configuration.
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
projects_root="$root/projects"
generated="$root/docker/generated"
nginx_generated="$root/docker/nginx/generated"

die() { printf '%s\n' "$*" >&2; exit 1; }
matches() {
  # grep checks individual lines; reject line breaks before validating one value.
  [ "$(printf '%s' "$1" | tr -d '\r\n')" = "$1" ] || return 1
  printf '%s' "$1" | LC_ALL=C grep -Eq "$2"
}
valid_name() { matches "$1" '^[a-z][a-z0-9_]*$'; }
valid_host() { matches "$1" '^[a-z0-9][a-z0-9.-]*[a-z0-9]$'; }
valid_php() { case "$1" in 7.4|8.1|8.3|8.4) return 0 ;; *) return 1 ;; esac; }
valid_document_root() {
  [ "$1" = . ] && return 0
  # Relative, literal path segments only: no traversal or Nginx syntax.
  matches "$1" '^[a-zA-Z0-9_-]+(/[a-zA-Z0-9_-]+)*$'
}
project_dir() { case "$1" in /*) printf '%s\n' "$1" ;; *) printf '%s/%s\n' "$root" "$1" ;; esac; }

# Reset fields before sourcing so a missing setting cannot inherit another project's value.
load_definition() {
  PROJECT_NAME= PROJECT_PATH= PHP_VERSION= HOSTNAME= DATABASE= DOCUMENT_ROOT=.
  . "$1"
}

# Quote values for the shell-readable definitions and YAML mount strings.
quote() { printf "'"; printf '%s' "$1" | sed "s/'/'\\\\''/g"; printf "'"; }
yaml_quote() { printf "'"; printf '%s' "$1" | sed "s/'/''/g"; printf "'"; }

# Keep application settings separate from the workspace registration. Never replace
# an existing environment or template: frameworks and users own those files.
ensure_application_env() {
  if [ ! -e "$source_path/.env.example" ]; then
    cat > "$source_path/.env.example" <<EOF
# Application connections inside the Docker network.
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=$DATABASE
DB_USERNAME=root
# Set this to MARIADB_ROOT_PASSWORD from docker/.env; do not commit credentials.
DB_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
EOF
  fi
  if [ ! -e "$source_path/.env" ]; then
    cp "$source_path/.env.example" "$source_path/.env"
  fi
}

sync() {
  mkdir -p "$generated" "$nginx_generated"
  staging=$(mktemp -d "$generated/.sync.XXXXXX")
  trap 'rm -rf "$staging"' EXIT
  trap 'exit 1' HUP INT TERM
  mkdir "$staging/nginx"
  compose_tmp="$staging/projects.compose.yml"
  services_tmp="$staging/project-services"
  nginx_volumes_tmp="$staging/nginx-volumes"
  sql_tmp="$staging/databases.sql"
  : > "$services_tmp"
  : > "$nginx_volumes_tmp"
  : > "$staging/hosts"
  printf '%s\n' '-- Generated by scripts/projects sync. Do not edit manually.' > "$sql_tmp"

  found=false
  for definition in "$projects_root"/*/project.env; do
    [ -f "$definition" ] || continue
    found=true
    load_definition "$definition"
    valid_name "$PROJECT_NAME" || die "Invalid project name in $definition"
    valid_php "$PHP_VERSION" || die "Unsupported PHP version in $definition: $PHP_VERSION"
    valid_host "$HOSTNAME" || die "Invalid hostname in $definition"
    valid_name "$DATABASE" || die "Invalid database name in $definition"
    valid_document_root "$DOCUMENT_ROOT" || die "Invalid document root in $definition"
    ! grep -Fxq "$HOSTNAME" "$staging/hosts" || die "Duplicate hostname: $HOSTNAME"
    printf '%s\n' "$HOSTNAME" >> "$staging/hosts"
    [ -n "$PROJECT_PATH" ] || die "Missing project path in $definition"
    case "$PROJECT_NAME" in nginx|mysql|mariadb|redis|database-init|phpmyadmin) die "Reserved project name: $PROJECT_NAME" ;; esac
    [ ! -f "$staging/nginx/$PROJECT_NAME.conf" ] || die "Duplicate project name: $PROJECT_NAME"
    source_path=$(project_dir "$PROJECT_PATH")
    [ -d "$source_path" ] || die "Project path does not exist: $PROJECT_PATH"
    [ -d "$source_path/$DOCUMENT_ROOT" ] || die "Document root does not exist: $source_path/$DOCUMENT_ROOT"
    web_suffix=
    [ "$DOCUMENT_ROOT" = . ] || web_suffix="/$DOCUMENT_ROOT"

    volume_path="../$PROJECT_PATH"
    case "$PROJECT_PATH" in /*) volume_path="$PROJECT_PATH" ;; esac
    # Project settings are opt-in: a project starts with the shared php.ini and
    # may add projects/<name>/dev/php.ini without changing infrastructure.
    cat >> "$services_tmp" <<EOF
  $PROJECT_NAME:
    build:
      context: ./php
      args:
        PHP_VERSION: "$PHP_VERSION"
    restart: unless-stopped
    working_dir: /var/www/html
    environment:
      DB_HOST: mariadb
      DB_PORT: 3306
      DB_DATABASE: $DATABASE
      REDIS_HOST: redis
      REDIS_PORT: 6379
    volumes:
      - $(yaml_quote "$volume_path:/var/www/html")
EOF
    if [ -f "$source_path/dev/php.ini" ]; then
      cat >> "$services_tmp" <<EOF
      - $(yaml_quote "$volume_path/dev/php.ini:/usr/local/etc/php/conf.d/zz-project.ini:ro")
EOF
    fi
    cat >> "$services_tmp" <<EOF
    networks:
      - app_network
EOF
    printf '      - %s\n' "$(yaml_quote "$volume_path:/var/www/projects/$PROJECT_NAME:ro")" >> "$nginx_volumes_tmp"
    # Nginx and PHP-FPM intentionally use different mount paths. PHP-FPM gets
    # a stable /var/www/html path; SCRIPT_FILENAME bridges the two locations.
    cat > "$staging/nginx/$PROJECT_NAME.conf" <<EOF
server {
    listen 80;
    server_name $HOSTNAME;
    root /var/www/projects/$PROJECT_NAME$web_suffix;
    index index.php index.html;

    location / {
        try_files \$uri \$uri/ /index.php?\$query_string;
    }

    # Block hidden files before the PHP matcher, including nested .env files.
    location ~ /\\. {
        deny all;
    }

    # Registration is infrastructure configuration, not application content.
    location ~ /project\\.env\$ {
        deny all;
    }

    location ~ \\.php\$ {
        try_files \$uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/html$web_suffix\$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT /var/www/html$web_suffix;
        # Resolve Docker DNS at request time so a stopped project cannot prevent
        # Nginx from starting and serving the other projects.
        set \$php_backend $PROJECT_NAME:9000;
        fastcgi_pass \$php_backend;
    }
}
EOF
    printf 'CREATE DATABASE IF NOT EXISTS `%s`;\n' "$DATABASE" >> "$sql_tmp"
  done
  if [ "$found" = true ]; then
    printf 'services:\n' > "$compose_tmp"
    cat "$services_tmp" >> "$compose_tmp"
    printf '  nginx:\n    volumes:\n' >> "$compose_tmp"
    cat "$nginx_volumes_tmp" >> "$compose_tmp"
  else
    printf 'services: {}\n' > "$compose_tmp"
  fi
  env_file="$root/docker/.env"
  [ -f "$env_file" ] || env_file="$root/docker/.env.example"
  docker compose --project-directory "$root/docker" --env-file "$env_file" \
    -f "$root/docker/docker-compose.yml" -f "$compose_tmp" config --quiet

  # Keep the bind-mounted directory itself in place so running Nginx sees updates.
  # No live files are touched until all definitions and Compose have validated.
  for config in "$staging/nginx"/*.conf; do
    [ -f "$config" ] || continue
    mv "$config" "$nginx_generated/$(basename "$config")"
  done
  for config in "$nginx_generated"/*.conf; do
    [ -f "$config" ] || continue
    stale_name=$(basename "$config" .conf)
    # A successfully generated service has a corresponding YAML service entry.
    grep -q "^  $stale_name:" "$compose_tmp" || rm -f "$config"
  done
  mv "$compose_tmp" "$generated/projects.compose.yml"
  mv "$sql_tmp" "$generated/databases.sql"

  # Only prepare application files after validation has succeeded.
  for definition in "$projects_root"/*/project.env; do
    [ -f "$definition" ] || continue
    load_definition "$definition"
    source_path=$(project_dir "$PROJECT_PATH")
    ensure_application_env
  done
}

add() {
  if [ "$#" -eq 2 ]; then
    default_host=$(printf '%s' "$1" | tr '_' '-')
    set -- "$1" "projects/$1" "$2" "$default_host.local" "$1"
  fi
  [ "$#" -eq 5 ] || [ "$#" -eq 6 ] || die 'Usage: scripts/projects add NAME PROJECT_PATH PHP_VERSION HOSTNAME DATABASE [DOCUMENT_ROOT]'
  name=$1 path=$2 php=$3 host=$4 database=$5
  document_root=${6:-.}
  valid_name "$name" || die 'NAME must use lowercase letters, numbers, and underscores.'
  valid_php "$php" || die 'PHP_VERSION must be one of: 7.4, 8.1, 8.3, 8.4.'
  valid_host "$host" || die 'HOSTNAME is invalid.'
  valid_name "$database" || die 'DATABASE must use lowercase letters, numbers, and underscores.'
  valid_document_root "$document_root" || die 'DOCUMENT_ROOT must be . or a relative path such as public.'
  case "$name" in nginx|mysql|mariadb|redis|database-init|phpmyadmin) die "Reserved project name: $name" ;; esac
  for definition in "$projects_root"/*/project.env; do
    [ -f "$definition" ] || continue
    if (PROJECT_NAME=; . "$definition"; [ "$PROJECT_NAME" = "$name" ]); then
      die "Project already exists: $name"
    fi
  done
  source_path=$(project_dir "$path")
  # Create the default workspace directory; custom source paths must already exist.
  new_source=false
  if [ ! -e "$source_path" ] && [ "$path" = "projects/$name" ]; then
    mkdir -p "$source_path"
    mkdir -p "$source_path/$document_root"
    new_source=true
  fi
  [ -d "$source_path" ] || die "Project path does not exist: $path"
  source_path=$(CDPATH= cd -- "$source_path" && pwd)
  # Definitions stay under projects/* so external and nested source paths can
  # be discovered without modifying the application's own environment file.
  if [ "$(dirname "$source_path")" = "$projects_root" ]; then
    target="$source_path/project.env"
  else
    target="$projects_root/$name/project.env"
  fi
  [ ! -e "$target" ] || die "Project already exists: $name"
  mkdir -p "$(dirname "$target")"
  cat > "$target" <<EOF
PROJECT_NAME=$name
PROJECT_PATH=$(quote "$path")
PHP_VERSION=$php
HOSTNAME=$host
DATABASE=$database
DOCUMENT_ROOT=$document_root
EOF
  if ! "$root/scripts/projects" sync; then
    rm -f "$target"
    die "Could not register $name; existing generated configuration was preserved."
  fi
  if [ "$new_source" = true ]; then
    cat > "$source_path/$document_root/index.php" <<EOF
<?php

// A small endpoint to verify that this project's own PHP runtime is being used.
header('Content-Type: text/plain; charset=utf-8');
echo "$name is running\\n";
echo 'PHP version: ' . PHP_VERSION . "\\n";
EOF
  fi
  printf 'Added %s. Add 127.0.0.1 %s to your hosts file, then run: make project-up NAME=%s\n' "$name" "$host" "$name"
}

list() {
  for definition in "$projects_root"/*/project.env; do
    [ -f "$definition" ] || continue
    load_definition "$definition"
    printf '%-18s PHP %-4s %-28s DB %s\n' "$PROJECT_NAME" "$PHP_VERSION" "$HOSTNAME" "$DATABASE"
  done
}

# Validate a requested project before a Make target passes its name to Compose.
check() {
  [ "$#" -eq 1 ] && valid_name "$1" || die 'Provide a valid project name: NAME=api'
  for definition in "$projects_root"/*/project.env; do
    [ -f "$definition" ] || continue
    load_definition "$definition"
    [ "$PROJECT_NAME" != "$1" ] || return 0
  done
  die "Unknown project: $1"
}

case "${1:-sync}" in
  sync) sync ;;
  add) shift; add "$@" ;;
  list) list ;;
  check) shift; check "$@" ;;
  *) die 'Usage: scripts/projects {sync|add|list|check}' ;;
esac
