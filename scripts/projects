#!/bin/sh
set -eu

# Keep definitions human-editable and derive all runtime wiring from them.
# This avoids duplicating project data across Compose and Nginx configuration.
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
projects_root="$root/projects"
generated="$root/docker/generated"
nginx_generated="$root/docker/nginx/generated"

die() { printf '%s\n' "$*" >&2; exit 1; }
matches() {
  # grep checks individual lines; reject line breaks before validating one value.
  [ "$(printf '%s' "$1" | tr -d '\r\n')" = "$1" ] || return 1
  printf '%s' "$1" | LC_ALL=C grep -Eq "$2"
}
valid_name() { matches "$1" '^[a-z][a-z0-9_]*$'; }
valid_volume() { matches "$1" '^[a-zA-Z0-9][a-zA-Z0-9_.-]*$'; }
valid_host() { matches "$1" '^[a-z0-9][a-z0-9.-]*[a-z0-9]$'; }
valid_php() { case "$1" in 7.4|8.1|8.3|8.4) return 0 ;; *) return 1 ;; esac; }
valid_port() { matches "$1" '^[1-9][0-9]{3,4}$' && [ "$1" -ge 1024 ] && [ "$1" -le 65535 ]; }
valid_document_root() {
  [ "$1" = . ] && return 0
  # Relative, literal path segments only: no traversal or Nginx syntax.
  matches "$1" '^[a-zA-Z0-9_-]+(/[a-zA-Z0-9_-]+)*$'
}
project_dir() { case "$1" in /*) printf '%s\n' "$1" ;; *) printf '%s/%s\n' "$root" "$1" ;; esac; }

# Read only workspace assignments; application dotenv values are never executed.
load_definition() {
  PROJECT_NAME= PROJECT_PATH= PHP_VERSION= HOSTNAME= DATABASE= DOCUMENT_ROOT=. HTTP_PORT=
  STORAGE_VOLUME= CACHE_VOLUME=
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in WORKSPACE_*=*|DB_DATABASE=*) ;; *) continue ;; esac
    key=${line%%=*}
    value=${line#*=}
    case "$value" in
      \"*\") value=${value#\"}; value=${value%\"} ;;
      \'*\') value=${value#\'}; value=${value%\'} ;;
    esac
    case "$key" in
      WORKSPACE_PROJECT_NAME) PROJECT_NAME=$value ;;
      WORKSPACE_PHP_VERSION) PHP_VERSION=$value ;;
      WORKSPACE_HOSTNAME) HOSTNAME=$value ;;
      DB_DATABASE) DATABASE=$value ;;
      WORKSPACE_DOCUMENT_ROOT) DOCUMENT_ROOT=$value ;;
      WORKSPACE_HTTP_PORT) HTTP_PORT=$value ;;
      WORKSPACE_STORAGE_VOLUME) STORAGE_VOLUME=$value ;;
      WORKSPACE_CACHE_VOLUME) CACHE_VOLUME=$value ;;
    esac
  done < "$1"
  PROJECT_PATH=$(CDPATH= cd -- "$(dirname "$1")" && pwd -P)
}

# Quote YAML mount strings.
yaml_quote() { printf "'"; printf '%s' "$1" | sed "s/'/''/g"; printf "'"; }

# Preserve existing application values when preparing missing dotenv files.
ensure_application_env() {
  if [ ! -e "$source_path/.env.example" ]; then
    cat > "$source_path/.env.example" <<EOF
APP_NAME=$PROJECT_NAME
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://$HOSTNAME

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Application connections inside the Docker network.
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=$DATABASE
DB_USERNAME=root
# Set this to MARIADB_ROOT_PASSWORD from docker/.env; do not commit credentials.
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
# Laravel 10 and earlier use CACHE_DRIVER instead of CACHE_STORE.
CACHE_DRIVER=file

# Requires predis/predis when using Redis; the PHP Redis extension is not installed.
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="\${APP_NAME}"
EOF
  fi
  if [ ! -e "$source_path/.env" ]; then
    cp "$source_path/.env.example" "$source_path/.env"
  fi
}

# Examples bootstrap fresh checkouts; runtime settings always come from .env.
prepare_envs() {
  for template in "$projects_root"/*/.env.example; do
    [ -f "$template" ] || continue
    [ -e "${template%.example}" ] || cp "$template" "${template%.example}"
  done
}

# Append the same documented Docker section to runtime files and new examples.
append_workspace_settings() {
  cat <<EOF

# -----------------------------------------------------------------------------
# Docker workspace configuration
# These WORKSPACE_* settings configure Docker and Nginx, not Laravel itself.
# After changing them, run from the workspace root: make project-up NAME=$1
# Database creation uses DB_DATABASE from the application section above.
# -----------------------------------------------------------------------------

# Docker service name. Use lowercase letters, numbers, and underscores.
# Keep this stable: renaming it changes the service used by workspace commands.
WORKSPACE_PROJECT_NAME=$1

# PHP version for this project's container. Supported: 7.4, 8.1, 8.3, 8.4.
WORKSPACE_PHP_VERSION=$2

# Local domain routed to this project. Add "127.0.0.1 $3" to /etc/hosts.
# Keep APP_URL above in sync when using this domain as the application URL.
WORKSPACE_HOSTNAME=$3

# Web directory relative to this project: use public for Laravel, . for plain PHP.
WORKSPACE_DOCUMENT_ROOT=$4

# Open http://localhost:$5 without editing /etc/hosts.
# Choose an unused port from 1024 to 65535; leave empty to disable this URL.
WORKSPACE_HTTP_PORT=$5
EOF
}

sync() {
  prepare_envs
  mkdir -p "$generated" "$nginx_generated"
  staging=$(mktemp -d "$generated/.sync.XXXXXX")
  trap 'rm -rf "$staging"' EXIT
  trap 'exit 1' HUP INT TERM
  mkdir "$staging/nginx"
  compose_tmp="$staging/projects.compose.yml"
  services_tmp="$staging/project-services"
  nginx_volumes_tmp="$staging/nginx-volumes"
  nginx_ports_tmp="$staging/nginx-ports"
  runtime_volumes_tmp="$staging/runtime-volumes"
  sql_tmp="$staging/databases.sql"
  : > "$services_tmp"
  : > "$nginx_volumes_tmp"
  : > "$nginx_ports_tmp"
  : > "$runtime_volumes_tmp"
  : > "$staging/ports"
  : > "$staging/hosts"
  printf '%s\n' '-- Generated by scripts/projects sync. Do not edit manually.' > "$sql_tmp"

  found=false
  for definition in "$projects_root"/*/.env; do
    [ -f "$definition" ] || continue
    load_definition "$definition"
    [ -n "$PROJECT_NAME" ] || continue
    found=true
    valid_name "$PROJECT_NAME" || die "Invalid project name in $definition"
    valid_php "$PHP_VERSION" || die "Unsupported PHP version in $definition: $PHP_VERSION"
    valid_host "$HOSTNAME" || die "Invalid hostname in $definition"
    valid_name "$DATABASE" || die "Invalid database name in $definition"
    valid_document_root "$DOCUMENT_ROOT" || die "Invalid document root in $definition"
    ! grep -Fxq "$HOSTNAME" "$staging/hosts" || die "Duplicate hostname: $HOSTNAME"
    printf '%s\n' "$HOSTNAME" >> "$staging/hosts"
    [ -n "$PROJECT_PATH" ] || die "Missing project path in $definition"
    case "$PROJECT_NAME" in nginx|mysql|mariadb|redis|database-init|phpmyadmin) die "Reserved project name: $PROJECT_NAME" ;; esac
    [ ! -f "$staging/nginx/$PROJECT_NAME.conf" ] || die "Duplicate project name: $PROJECT_NAME"
    source_path=$(project_dir "$PROJECT_PATH")
    [ -d "$source_path" ] || die "Project path does not exist: $PROJECT_PATH"
    [ -d "$source_path/$DOCUMENT_ROOT" ] || die "Document root does not exist: $source_path/$DOCUMENT_ROOT"
    web_suffix=
    [ "$DOCUMENT_ROOT" = . ] || web_suffix="/$DOCUMENT_ROOT"
    port_listener=
    if [ -n "$HTTP_PORT" ]; then
      valid_port "$HTTP_PORT" || die "Invalid HTTP port in $definition: $HTTP_PORT"
      ! grep -Fxq "$HTTP_PORT" "$staging/ports" || die "Duplicate HTTP port: $HTTP_PORT"
      printf '%s\n' "$HTTP_PORT" >> "$staging/ports"
      printf '      - "127.0.0.1:%s:%s"\n' "$HTTP_PORT" "$HTTP_PORT" >> "$nginx_ports_tmp"
      port_listener="listen $HTTP_PORT;"
    fi

    volume_path="../$PROJECT_PATH"
    case "$PROJECT_PATH" in /*) volume_path="$PROJECT_PATH" ;; esac
    source_mode=
    storage_location=
    if [ -n "$STORAGE_VOLUME$CACHE_VOLUME" ]; then
      valid_volume "$STORAGE_VOLUME" && valid_volume "$CACHE_VOLUME" || die "Provide valid storage and cache volume names in $definition"
      [ -d "$source_path/storage" ] && [ -d "$source_path/bootstrap/cache" ] || die "Missing Laravel runtime directories in $source_path"
      source_mode=:ro
      cat >> "$runtime_volumes_tmp" <<EOF
  ${PROJECT_NAME}_storage:
    external: true
    name: $STORAGE_VOLUME
  ${PROJECT_NAME}_cache:
    external: true
    name: $CACHE_VOLUME
EOF
      storage_location="location /storage/ { alias /var/www/projects/$PROJECT_NAME/storage/app/public/; }"
    fi
    # Project settings are opt-in: a project starts with the shared php.ini and
    # may add projects/<name>/dev/php.ini without changing infrastructure.
    cat >> "$services_tmp" <<EOF
  $PROJECT_NAME:
    build:
      context: ./php
      args:
        PHP_VERSION: "$PHP_VERSION"
    restart: unless-stopped
    working_dir: /var/www/html
    volumes:
      - $(yaml_quote "$volume_path:/var/www/html$source_mode")
EOF
    if [ -n "$STORAGE_VOLUME" ]; then
      cat >> "$services_tmp" <<EOF
      - ${PROJECT_NAME}_storage:/var/www/html/storage
      - ${PROJECT_NAME}_cache:/var/www/html/bootstrap/cache
      - $(yaml_quote "$volume_path/dev/logs:/var/www/html/dev/logs")
      - $(yaml_quote "$volume_path/dev/logs:/var/www/html/storage/logs")
EOF
      printf '      - %s_storage:/var/www/projects/%s/storage:ro\n' "$PROJECT_NAME" "$PROJECT_NAME" >> "$nginx_volumes_tmp"
    fi
    if [ -f "$source_path/dev/php.ini" ]; then
      cat >> "$services_tmp" <<EOF
      - $(yaml_quote "$volume_path/dev/php.ini:/usr/local/etc/php/conf.d/zz-project.ini:ro")
EOF
    fi
    cat >> "$services_tmp" <<EOF
    networks:
      - app_network
EOF
    printf '      - %s\n' "$(yaml_quote "$volume_path:/var/www/projects/$PROJECT_NAME:ro")" >> "$nginx_volumes_tmp"
    # Nginx and PHP-FPM intentionally use different mount paths. PHP-FPM gets
    # a stable /var/www/html path; SCRIPT_FILENAME bridges the two locations.
    cat > "$staging/nginx/$PROJECT_NAME.conf" <<EOF
server {
    listen 80;
    $port_listener
    server_name $HOSTNAME;
    root /var/www/projects/$PROJECT_NAME$web_suffix;
    index index.php index.html;
    $storage_location

    location / {
        try_files \$uri \$uri/ /index.php?\$query_string;
    }

    # Project development settings and logs are never public content.
    location = /dev { deny all; }
    location ^~ /dev/ { deny all; }

    # Block hidden files before the PHP matcher, including nested .env files.
    location ~ /\\. {
        deny all;
    }

    # Registration is infrastructure configuration, not application content.
    location ~ /project\\.env\$ {
        deny all;
    }

    location ~ \\.php\$ {
        try_files \$uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/html$web_suffix\$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT /var/www/html$web_suffix;
        # Resolve Docker DNS at request time so a stopped project cannot prevent
        # Nginx from starting and serving the other projects.
        set \$php_backend $PROJECT_NAME:9000;
        fastcgi_pass \$php_backend;
    }
}
EOF
    printf 'CREATE DATABASE IF NOT EXISTS `%s`;\n' "$DATABASE" >> "$sql_tmp"
  done
  if [ "$found" = true ]; then
    printf 'services:\n' > "$compose_tmp"
    cat "$services_tmp" >> "$compose_tmp"
    printf '  nginx:\n    volumes:\n' >> "$compose_tmp"
    cat "$nginx_volumes_tmp" >> "$compose_tmp"
    if [ -s "$nginx_ports_tmp" ]; then
      printf '    ports:\n' >> "$compose_tmp"
      cat "$nginx_ports_tmp" >> "$compose_tmp"
    fi
    if [ -s "$runtime_volumes_tmp" ]; then
      printf 'volumes:\n' >> "$compose_tmp"
      cat "$runtime_volumes_tmp" >> "$compose_tmp"
    fi
  else
    printf 'services: {}\n' > "$compose_tmp"
  fi
  env_file="$root/docker/.env"
  [ -f "$env_file" ] || env_file="$root/docker/.env.example"
  docker compose --project-directory "$root/docker" --env-file "$env_file" \
    -f "$root/docker/docker-compose.yml" -f "$compose_tmp" config --quiet

  # Keep the bind-mounted directory itself in place so running Nginx sees updates.
  # No live files are touched until all definitions and Compose have validated.
  for config in "$staging/nginx"/*.conf; do
    [ -f "$config" ] || continue
    mv "$config" "$nginx_generated/$(basename "$config")"
  done
  for config in "$nginx_generated"/*.conf; do
    [ -f "$config" ] || continue
    stale_name=$(basename "$config" .conf)
    # A successfully generated service has a corresponding YAML service entry.
    grep -q "^  $stale_name:" "$compose_tmp" || rm -f "$config"
  done
  mv "$compose_tmp" "$generated/projects.compose.yml"
  mv "$sql_tmp" "$generated/databases.sql"

  # Only prepare application files after validation has succeeded.
  for definition in "$projects_root"/*/.env; do
    [ -f "$definition" ] || continue
    load_definition "$definition"
    [ -n "$PROJECT_NAME" ] || continue
    source_path=$(project_dir "$PROJECT_PATH")
    # Adopted runtime volumes and existing source directories are already prepared.
    [ -z "$STORAGE_VOLUME" ] || continue
    ensure_application_env
    # Bind-mounted log folders must be writable by PHP-FPM and the host user.
    mkdir -p "$source_path/dev/logs"
    chmod 0777 "$source_path/dev/logs"
    touch "$source_path/dev/logs/php-error.log"
    chmod 0666 "$source_path/dev/logs/php-error.log"
  done
}

add() {
  if [ "$#" -eq 2 ]; then
    default_host=$(printf '%s' "$1" | tr '_' '-')
    set -- "$1" "projects/$1" "$2" "$default_host.local" "$1"
  fi
  [ "$#" -ge 5 ] && [ "$#" -le 7 ] || die 'Usage: scripts/projects add NAME PROJECT_PATH PHP_VERSION HOSTNAME DATABASE [DOCUMENT_ROOT] [HTTP_PORT]'
  name=$1 path=$2 php=$3 host=$4 database=$5
  document_root=${6:-.}
  requested_port=${7:-}
  valid_name "$name" || die 'NAME must use lowercase letters, numbers, and underscores.'
  valid_php "$php" || die 'PHP_VERSION must be one of: 7.4, 8.1, 8.3, 8.4.'
  valid_host "$host" || die 'HOSTNAME is invalid.'
  valid_name "$database" || die 'DATABASE must use lowercase letters, numbers, and underscores.'
  valid_document_root "$document_root" || die 'DOCUMENT_ROOT must be . or a relative path such as public.'
  case "$name" in nginx|mysql|mariadb|redis|database-init|phpmyadmin) die "Reserved project name: $name" ;; esac
  prepare_envs
  used_ports='8081 8082'
  for definition in "$projects_root"/*/.env; do
    [ -f "$definition" ] || continue
    load_definition "$definition"
    used_ports="$used_ports $HTTP_PORT"
    if [ "$PROJECT_NAME" = "$name" ]; then
      die "Project already exists: $name"
    fi
  done
  if [ -z "$requested_port" ]; then
    requested_port=8083
    while printf '%s\n' "$used_ports" | tr ' ' '\n' | grep -Fxq "$requested_port"; do
      requested_port=$((requested_port + 1))
    done
  fi
  valid_port "$requested_port" || die 'HTTP_PORT must be between 1024 and 65535.'
  ! printf '%s\n' "$used_ports" | tr ' ' '\n' | grep -Fxq "$requested_port" || die "HTTP port already assigned: $requested_port"
  source_path=$(project_dir "$path")
  # Create the default workspace directory; custom source paths must already exist.
  new_source=false
  if [ ! -e "$source_path" ] && [ "$path" = "projects/$name" ]; then
    mkdir -p "$source_path"
    mkdir -p "$source_path/$document_root"
    new_source=true
  fi
  [ -d "$source_path" ] || die "Project path does not exist: $path"
  source_path=$(CDPATH= cd -- "$source_path" && pwd -P)
  [ -d "$source_path/$document_root" ] || die "Document root does not exist: $source_path/$document_root"
  # External and nested sources are discovered through a directory link only.
  link_path="$projects_root/$name"
  link_created=false
  if [ "$source_path" != "$link_path" ]; then
    [ ! -e "$link_path" ] && [ ! -L "$link_path" ] || die "Project directory already exists: $link_path"
    ln -s "$source_path" "$link_path"
    link_created=true
  fi
  target="$source_path/.env"
  env_existed=false
  example_existed=false
  [ ! -e "$source_path/.env.example" ] || example_existed=true
  backup=$(mktemp)
  if [ -e "$target" ]; then
    env_existed=true
    cp "$target" "$backup"
  fi
  PROJECT_NAME=$name HOSTNAME=$host DATABASE=$database
  ensure_application_env
  load_definition "$target"
  if [ -n "$PROJECT_NAME" ]; then
    if [ "$env_existed" = true ]; then
      cp "$backup" "$target"
    else
      rm -f "$target"
    fi
    [ "$example_existed" = true ] || rm -f "$source_path/.env.example"
    rm -f "$backup"
    [ "$link_created" = false ] || rm "$link_path"
    die "Project already registered in $target"
  fi
  # Preserve application database choices; only fill a missing assignment.
  if ! grep -q '^DB_DATABASE=' "$target"; then
    printf '\nDB_DATABASE=%s\n' "$database" >> "$target"
  fi
  append_workspace_settings "$name" "$php" "$host" "$document_root" "$requested_port" >> "$target"
  if ! "$root/scripts/projects" sync; then
    if [ "$env_existed" = true ]; then
      cp "$backup" "$target"
    else
      rm -f "$target"
    fi
    [ "$example_existed" = true ] || rm -f "$source_path/.env.example"
    [ "$link_created" = false ] || rm "$link_path"
    rm -f "$backup"
    die "Could not register $name; existing generated configuration was preserved."
  fi
  rm -f "$backup"
  # Only newly generated examples receive registration defaults; existing
  # application examples and secrets are preserved.
  if [ "$example_existed" = false ]; then
    append_workspace_settings "$name" "$php" "$host" "$document_root" "$requested_port" >> "$source_path/.env.example"
  fi
  if [ "$new_source" = true ]; then
    cat > "$source_path/$document_root/index.php" <<EOF
<?php

// A small endpoint to verify that this project's own PHP runtime is being used.
header('Content-Type: text/plain; charset=utf-8');
echo "$name is running\\n";
echo 'PHP version: ' . PHP_VERSION . "\\n";
EOF
  fi
  printf 'Added %s. Open http://localhost:%s or map 127.0.0.1 %s in your hosts file. Start with: make project-up NAME=%s\n' "$name" "$requested_port" "$host" "$name"
}

list() {
  prepare_envs
  for definition in "$projects_root"/*/.env; do
    [ -f "$definition" ] || continue
    load_definition "$definition"
    [ -n "$PROJECT_NAME" ] || continue
    printf '%-18s PHP %-4s %-28s DB %-18s localhost:%s\n' "$PROJECT_NAME" "$PHP_VERSION" "$HOSTNAME" "$DATABASE" "${HTTP_PORT:-disabled}"
  done
}

# Validate a requested project before a Make target passes its name to Compose.
check() {
  prepare_envs
  [ "$#" -eq 1 ] && valid_name "$1" || die 'Provide a valid project name: NAME=api'
  for definition in "$projects_root"/*/.env; do
    [ -f "$definition" ] || continue
    load_definition "$definition"
    [ "$PROJECT_NAME" != "$1" ] || return 0
  done
  die "Unknown project: $1"
}

case "${1:-sync}" in
  sync) sync ;;
  add) shift; add "$@" ;;
  list) list ;;
  check) shift; check "$@" ;;
  *) die 'Usage: scripts/projects {sync|add|list|check}' ;;
esac
